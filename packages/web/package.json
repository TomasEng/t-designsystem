{
  "name": "tomas-designsystem",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tomas-designsystem.css": {
      "import": "./dist/tomas-designsystem.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build && pnpm run build-types",
    "build-types": "tsc --project tsconfig.build-types.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-wc/lit-helpers": "0.7.0",
    "lit": "3.3.2"
  },
  "devDependencies": {
    "@eslint/css": "1.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "internal": "workspace:^",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-lit": "1.0.1"
  }
}
