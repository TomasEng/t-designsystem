{
  "name": "tomas-designsystem-root",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "all-checks": "pnpm build && pnpm typecheck && pnpm test && pnpm lint && pnpm codestyle",
    "build": "pnpm -r build",
    "build-docs": "pnpm --filter tomas-designsystem-docs build",
    "codestyle": "prettier --check .",
    "codestyle:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start-docs": "pnpm --filter tomas-designsystem-docs start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
